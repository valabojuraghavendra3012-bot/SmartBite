# The browser uses the same-origin /api path; Vite proxies it to FastAPI in development.
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Supabase email/password auth. Leave blank to use the local, browser-only demo session.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set true for browser-local demo data; false to call the configured API.
VITE_DEMO_MODE=false
